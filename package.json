{
  "name": "where-builds-meet",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run i18n:check && npm run test && tsc -b && vite build",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint && oxlint -c src/ui/.oxlintrc.json src/ui && stylelint \"src/**/*.css\"",
    "lint:fix": "oxlint --fix && oxlint -c src/ui/.oxlintrc.json --fix src/ui && stylelint --fix \"src/**/*.css\"",
    "test": "vitest run --exclude tests/dps-snapshots.test.ts",
    "test:watch": "vitest --exclude tests/dps-snapshots.test.ts",
    "typecheck": "tsc -b",
    "prepare": "husky",
    "i18n:extract": "node script/i18n/extract.mjs",
    "i18n:check": "node script/i18n/extract.mjs --check",
    "validate:presets": "vitest run tests/preset-eligibility.test.ts",
    "preview": "vite preview",
    "test:wts": "vitest run tests/wts-cast-snapshot.test.ts tests/healing.test.ts tests/damage-replay.test.ts tests/damage-recording.test.ts",
    "test:sets": "vitest run tests/weapon-set-four-piece.test.ts",
    "test:dps": "vitest run tests/dps-snapshot-guard.test.ts tests/dps-snapshots.test.ts",
    "snapshots:dps:update": "vitest run tests/dps-snapshots.test.ts",
    "test:innerways": "vitest run tests/innerway-filter.test.ts tests/innerway-stat-visibility.test.ts tests/innerway-catalog.test.ts tests/echoes-t4.test.ts tests/rodent-rampage.test.ts tests/vendetta.test.ts tests/draught-innerways.test.ts tests/innerway-solo-level.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource-variable/noto-sans-kr": "^5.3.0",
    "@fontsource-variable/noto-sans-tc": "^5.3.0",
    "@tabler/icons-react": "^3.46.0",
    "nanoid": "^6.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tesseract.js": "^7.0.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^7.0.2",
    "typescript-classic": "npm:typescript@^5.9.2",
    "vite": "^8.3.0",
    "vite-imagetools": "^12.0.1",
    "vitest": "^5.0.0"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "*.{json,jsonc,md}": [
      "oxfmt --write"
    ],
    "*.css": [
      "stylelint --fix",
      "oxfmt --write"
    ]
  }
}
